<?xml version="1.0" encoding="utf-8"?>
<com.kdt.DefocusableScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/fragment_padding_medium">

        <TextView
            android:id="@+id/hard_mod_title"
            style="@style/TextAppearance.AppCompat.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/padding_large"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/hard_mod_subtitle"
            style="@style/TextAppearance.AppCompat.Subhead"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/padding_small"
            android:layout_marginBottom="@dimen/padding_large"
            android:textColor="#AAAAAA" />

        <View
            style="@style/ThickDivider"
            android:layout_width="match_parent"
            android:layout_marginBottom="@dimen/padding_large" />

        <TextView
            android:id="@+id/hard_mod_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/padding_large"
            android:textColor="#CCCCCC"
            android:textSize="14sp" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/hard_mod_primary_download"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/padding_large"
            android:layout_marginBottom="@dimen/padding_large" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/hard_mod_secondary_download"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/padding_large"
            android:layout_marginBottom="@dimen/padding_large" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/hard_mod_wiki"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/padding_large"
            android:layout_marginBottom="@dimen/padding_extra_extra_large"
            android:text="@string/open_wiki" />

    </LinearLayout>
</com.kdt.DefocusableScrollView>
