<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/background_app">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Создание кастомной сборки"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/profile_name_edit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Название сборки"
        android:textColor="#FFFFFF"
        android:textColorHint="#AAAAAA"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#3A3A3A"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Версия Minecraft:"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="4dp"/>
    <Spinner
        android:id="@+id/mc_version_spinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#3A3A3A"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Загрузчик модов:"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="4dp"/>
    <Spinner
        android:id="@+id/loader_spinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#3A3A3A"/>

    <com.kdt.mcgui.MineButton
        android:id="@+id/manage_mods_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Управление модами"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Установленные моды:"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/installed_mods_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <com.kdt.mcgui.MineButton
        android:id="@+id/save_profile_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Сохранить профиль"
        android:layout_marginTop="16dp"/>

</LinearLayout>
